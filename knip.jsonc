{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Treat exports referenced only in their declaring file as used.
  // Types in `packages/*/src/types/*.ts` are organized by topic and consumed via
  // `export type *` re-exports; flagging them as unused on every same-file
  // reference is noise after the knip v5 → v6 bump.
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    // Declared in pnpm packageExtensions for @vue/test-utils peer resolution.
    "@vue/compiler-dom",
    "@vue/server-renderer",
    "vue",
  ],
  "ignore": [
    // Runtime-loaded fixtures behind nested package.json boundaries
    // (type=module, type=commonjs, and no explicit type).
    "packages/core/tests/runner/fixtures/vm-external/module-semantics/{ambiguous,explicit-*}/**",
  ],
  "workspaces": {
    ".": {
      "entry": [
        "rslint.config.mts",
        // Agent skill scripts are invoked by the skill runtime, not imported by source files.
        ".agents/skills/**/scripts/**/*.mjs",
      ],
    },
    "scripts": {
      "entry": [
        // The root config lists `scripts/lint` as a project, but knip resolves its
        // `<rootDir>` against the `scripts` workspace instead of `scripts/lint`.
        "lint/*.test.ts",
        // Minimal rslint config that `os-agnostic-rule.test.ts` loads by path.
        "lint/os-agnostic-rule.rslint.mjs",
      ],
    },
    "benchmarks": {
      "entry": [
        "createFrontendMemoryFixture.mjs",
        // Benchmark fixtures are loaded dynamically by the benchmark entrypoints.
        "fixtures/**/rstest.config.mts",
        "fixtures/**/*.ts",
      ],
      "ignoreDependencies": [
        // Used by the generated synthetic memory workload source files.
        "antd",
        "react",
        "react-dom",
        "three",
      ],
    },
    "examples/federation/component-app": {
      // Module Federation remotes are resolved by its runtime.
      "ignoreDependencies": ["node-local-remote"],
    },
    "examples/federation/main-app": {
      // Module Federation remotes are resolved by its runtime.
      "ignoreDependencies": ["component-app", "node-local-remote"],
    },
    "examples/federation/node-local-remote": {
      // Exposed as a Module Federation remote from the Rsbuild config.
      "entry": ["src/test.js"],
    },
    "packages/core": {
      "ignoreDependencies": [
        // rslib.config.ts aliases this import to @vitest/utils' bundled instance.
        "tinyrainbow",
      ],
      "entry": [
        // Runtime files copied to dist via CopyRspackPlugin (dynamically loaded)
        "src/core/plugins/mockRuntimeCode.js",
        "src/core/plugins/importActualLoader.mjs",
        "src/core/plugins/wasmLoader.mjs",
        "src/core/plugins/styleFallbackLoader.mjs",
        "src/pool/rstestSuppressWarnings.cjs",
        // coverage/checkThresholds.ts uses picomatch but is only reachable via
        // nested dynamic imports that knip cannot fully trace
        "src/coverage/checkThresholds.ts",
        // Webpack license plugin used by rslib.config.ts
        "licensePlugin.ts",
        // Fixtures loaded by path at runtime, not imported by tests.
        "tests/**/fixtures/**",
      ],
    },
    "packages/browser": {
      "ignoreUnresolved": [
        // Virtual module injected by each browser project's Rsbuild alias
        "__rstest_virtual_browser_manifest__",
      ],
    },
    "packages/vscode": {
      "entry": [
        // Only `tests/unit` runs on Rstest; the Mocha suite in VS Code and its
        // fixture workspaces are outside the Rstest config.
        "tests/**/*.ts",
        // Test fixture files (read by parser at runtime, not imported)
        "tests/fixtures/**/test/*.{jsx,tsx}",
        // Sample project for e2e testing
        "sample/**/*.ts",
      ],
      "ignoreDependencies": [
        // CLI tool used in CI/release scripts, not in code
        "ovsx",
        // Used in sample/rsbuild.config.ts for testing the extension
        "@rsbuild/plugin-react",
      ],
    },
  },
  "ignoreWorkspaces": ["e2e/**", "website"],
}
