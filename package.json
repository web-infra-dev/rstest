{
  "name": "rstest-monorepo",
  "private": true,
  "scripts": {
    "bench:cpu": "pnpm --filter @rstest/benchmarks bench:cpu",
    "bench:memory": "pnpm --filter @rstest/benchmarks bench:memory",
    "build": "pnpm --filter \"./packages/*\" run build",
    "bump": "bumpp",
    "check-dependency-version": "pnpx check-dependency-version-consistency --ignore-package @rstest/test-mock-re-exports --ignore-package @rstest/e2e-environment-affinity-jsdom-26 --ignore-package @rstest/e2e-environment-affinity-jsdom-29 . && echo",
    "check-doc-types": "node .agents/skills/api-doc-sync/scripts/check-type-blocks.mjs",
    "check-harness-docs": "node scripts/harness/check-harness-docs.mjs",
    "check-spell": "cspell && heading-case",
    "check-unused": "knip",
    "check-version-consistency": "node scripts/checkVersionConsistency.mjs",
    "e2e": "cd e2e && pnpm test && pnpm test:commonjs && pnpm test:no-isolate",
    "format": "rs fmt && heading-case --write",
    "lint": "rs fmt --check && pnpm run check-spell && pnpm run check-doc-types && pnpm run check-harness-docs && pnpm run lint:type",
    "lint:type": "rslint --type-check",
    "prepare": "lefthook install",
    "test": "rstest",
    "test:examples": "pnpm --filter \"@examples/*\" --filter \"!@examples/federation*\" test",
    "test:federation": "pnpm -C examples/federation test",
    "test:vscode": "pnpm --filter ./packages/vscode test",
    "typecheck": "pnpm run lint:type"
  },
  "devDependencies": {
    "@rslint/core": "^0.9.0",
    "@rstest/core": "workspace:*",
    "@types/node": "^22.16.5",
    "bumpp": "^11.1.0",
    "check-dependency-version-consistency": "^6.0.0",
    "cross-env": "^10.1.0",
    "cspell": "10.3.3",
    "cspell-ban-words": "^0.0.4",
    "heading-case": "^1.1.8",
    "knip": "^6.36.0",
    "lefthook": "^2.1.14",
    "pkg-pr-new": "^0.0.88",
    "playwright": "^1.63.0",
    "prettier": "^3.9.7",
    "prettier-plugin-packagejson": "^3.0.2",
    "rstack": "0.8.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": "^22.18.0 || >=24.3.0",
    "pnpm": ">=11.27.0"
  }
}
