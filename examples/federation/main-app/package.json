{
  "name": "@examples/federation-main-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rsbuild build --config rsbuild.browser.config.js",
    "serve": "serve dist -p 3002",
    "start": "concurrently \"npm run build\" \"npm run serve\"",
    "test": "rstest --reporter=verbose",
    "test:browser": "rstest --config rstest.browser.config.ts --reporter=verbose"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@module-federation/rsbuild-plugin": "2.9.0",
    "@module-federation/rstest": "2.9.0",
    "@rsbuild/core": "~2.2.0",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rstest/browser": "workspace:*",
    "@rstest/core": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "concurrently": "8.2.2",
    "kill-port": "^2.0.1",
    "playwright": "^1.62.1",
    "serve": "14.2.6"
  }
}
