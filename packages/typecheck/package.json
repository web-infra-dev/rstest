{
  "name": "@rstest/typecheck",
  "version": "0.12.4",
  "description": "Static type testing for Rstest.",
  "keywords": [
    "rstest",
    "typescript",
    "typecheck",
    "test"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/web-infra-dev/rstest.git",
    "directory": "packages/typecheck"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "lint": "rslint ."
  },
  "dependencies": {
    "expect-type": "^1.4.0",
    "get-tsconfig": "5.0.0-beta.6",
    "pathe": "^2.0.3",
    "yuku-ast": "^0.19.0",
    "yuku-parser": "^0.19.0"
  },
  "devDependencies": {
    "@rslib/core": "catalog:",
    "@rstest/core": "workspace:*",
    "@rstest/tsconfig": "workspace:*"
  },
  "peerDependencies": {
    "@rstest/core": "workspace:*"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
